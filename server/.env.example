# --- Server ---
PORT=4000
NODE_ENV=development
# Kamida 32 belgili tasodifiy satr. Masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Frontend manzili (CORS va cookie uchun, dev rejimida Vite proxy ishlatiladi)
CLIENT_ORIGIN=http://localhost:5173

# --- Ma'lumotlar bazasi (PostgreSQL) ---
# "npm run dev" o'rnatilgan PostgreSQL bo'lmasa, embedded-postgres orqali 5433-portda lokal baza ishga tushiradi.
DATABASE_URL=postgresql://agro:agro_local_pw@localhost:5433/agromaslahat
# O'z PostgreSQL serveringizdan foydalansangiz: LOCAL_DB=false
LOCAL_DB=true
LOCAL_DB_PORT=5433
LOCAL_DB_USER=agro
LOCAL_DB_PASSWORD=agro_local_pw
LOCAL_DB_NAME=agromaslahat

# --- Google Gemini (AgroAI) ---
# Kalit: https://aistudio.google.com/apikey . Bo'sh qoldirilsa AgroAI "ulanmagan" holatini ko'rsatadi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ob-havo ---
# Standart: Open-Meteo (kalit talab qilmaydi). URL ni o'zgartirish ixtiyoriy.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
